<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Fiona.Core.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>

    <!-- Fiona.Core is netstandard2.0 and its own language level is older; the tests are free to be
         current, and nothing here ships. -->
    <LangVersion>latest</LangVersion>

    <!-- The solution has no AnyCPU configuration, so accept whichever platform it is built with
         rather than failing the solution build. -->
    <Platforms>AnyCPU;x86;x64;ARM</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fiona.Core\Fiona.Core.csproj" />
  </ItemGroup>

</Project>
