<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Fiona.Core</RootNamespace>
    <Version>0.1.0</Version>
    <Authors>Paolo Marcucci</Authors>
    <Company>thatpaolo.com</Company>
    <Product>Fiona</Product>
    <Copyright>Copyright Paolo Marcucci 2021</Copyright>
    <PackageProjectUrl>http://www.thatpaolo.com/apps/fiona</PackageProjectUrl>
  </PropertyGroup>

   <ItemGroup>
     <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
   </ItemGroup>

   <ItemGroup>
     <Folder Include="Properties\" />
